{
  "name": "@j2w/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --loader tsx dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-agents": "tsx src/db/seedAgents.ts",
    "db:seed-demo": "tsx src/db/demo/seedDemo.ts",
    "db:import-hp-kb": "tsx src/db/importHpKb.ts",
    "db:promote-platform-admin": "tsx src/db/promotePlatformAdmin.ts",
    "db:bootstrap-admin": "tsx src/db/createBootstrap.ts",
    "db:create-tenant-user": "tsx src/db/createTenantUser.ts"
  },
  "dependencies": {
    "@deepgram/sdk": "^3.6.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.1",
    "@j2w/db": "workspace:*",
    "@j2w/ingest-shared": "workspace:*",
    "@j2w/offer-letter-db": "workspace:*",
    "@j2w/shared-types": "workspace:*",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.7",
    "argon2": "^0.44.0",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "openai": "^4.60.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "resend": "^6.12.2",
    "sentiment": "^5.0.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/sentiment": "^5.0.4",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  }
}
