# Template — paste into Dokploy UI → Service → Environment, then fill in
# real values. NOT committed with secrets; the actual values live in Dokploy.
# Used by deploy/docker-compose.dokploy.yml.

# --- Required: Dokploy / Traefik routing -----------------------------------
# Host: AWS EC2, Elastic IP 13.127.19.121 (see docs/dokploy-on-this-server.md).
# Must be unique on the host (`app` is taken by cognition).
COMPOSE_PROJECT_NAME=recruitassist-prod
# Used in Traefik label keys; [a-z0-9-] only. (`cognition` is taken.)
APP_SLUG=recruitassist
# Public hostname; A-record points at the host (13.127.19.121).
APP_HOST=recruitassist.joulestowatts.online

# --- Required: secrets -----------------------------------------------------
# `openssl rand -hex 32`  — 64 chars
POSTGRES_PASSWORD=
# `openssl rand -hex 64`  — 128 chars; min 32 enforced by api/src/env.ts
JWT_SECRET=
# `node -e "console.log(crypto.randomBytes(32).toString('base64'))"`
# 44 chars; validated as 32-byte base64 at api boot.
# *** BACK THIS UP OFF-VM (1Password etc). Lose it = every tenant's
#     stored integration credentials are unrecoverable. ***
INTEGRATIONS_KEK=

# --- Bootstrap admin (first user inside RecruitAssist) ---------------------
# Set BOTH before first deploy so migrate auto-creates the first user.
# After deploy, sign in to https://recruitassist.joulestowatts.online with
# these credentials, then invite real users via the platform admin flow.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Optional: AI providers (leave blank to disable each feature) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEEPGRAM_API_KEY=
SARVAM_API_SUBSCRIPTION_KEY=
SHUNYA_API_KEY=

# --- Optional: Vapi voice agent --------------------------------------------
VAPI_API_KEY=
VAPI_PUBLIC_KEY=
# `openssl rand -hex 32` — HMAC for Vapi webhook payloads
VAPI_WEBHOOK_SECRET=

# --- Optional: custom-transcriber HMAC -------------------------------------
# Shared secret in Vapi's custom-transcriber handshake. Leave blank if
# not using Sarvam/Shunya bridges.
CUSTOM_TRANSCRIBER_SECRET=

# --- Optional: transactional email (Resend) --------------------------------
RESEND_API_KEY=
RESEND_FROM=RecruitAssist <no-reply@recruitassist.joulestowatts.online>

# --- Optional: J2W Offer Letter MySQL (read-only) --------------------------
# When unset, OL-backed routes return 503 {error:"offer_letter_not_configured"}.
OFFER_LETTER_MYSQL_HOST=j2wofferletter-prod.ca8kj4bjkq5a.ap-south-1.rds.amazonaws.com
OFFER_LETTER_MYSQL_PORT=3306
OFFER_LETTER_MYSQL_USER=mis_operations
OFFER_LETTER_MYSQL_PASSWORD=
OFFER_LETTER_MYSQL_DATABASE=offerletter
OFFER_LETTER_MYSQL_TLS=true

# --- Optional: tuning ------------------------------------------------------
# Days of recorded WAVs the recordingPrune worker keeps.
RECORDING_RETENTION_DAYS=90

# --- Postgres user/db (override only if you have a reason) ----------------
# POSTGRES_USER=recruitassist
# POSTGRES_DB=recruitassist
