# Shared image for api + worker (RecruitAssist). Both services run from this;
# compose sets the CMD. Node 20 LTS; Debian slim for native deps (argon2, pdf-parse).
FROM node:20-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@9.9.0 --activate
WORKDIR /app

# ---- deps ----
FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml .npmrc package.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/desktop/package.json apps/desktop/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/ingest-shared/package.json packages/ingest-shared/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
RUN pnpm install --frozen-lockfile

# ---- build ----
FROM deps AS build
COPY packages packages
COPY apps/api apps/api
COPY apps/worker apps/worker
RUN pnpm --filter @j2w/api build

# ---- runtime ----
FROM base AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 1001 app
COPY --from=build --chown=app:app /app /app
USER app
ENV NODE_ENV=production
EXPOSE 8787
# No default CMD — docker-compose sets the command per service (api vs worker).
