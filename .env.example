# --- Database ---
POSTGRES_USER=recruitassist
POSTGRES_PASSWORD=recruitassist_dev
POSTGRES_DB=recruitassist
POSTGRES_PORT=5432
DATABASE_URL=postgres://recruitassist:recruitassist_dev@localhost:5432/recruitassist

# --- Redis (BullMQ) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8787
API_PUBLIC_URL=http://localhost:8787
JWT_SECRET=change-me-in-prod-min-32-chars-long-xxxxx

# --- Transcription providers (STT) ---
# Deepgram — used natively by Vapi's `transcriber: { provider: "deepgram" }`.
DEEPGRAM_API_KEY=
# Sarvam AI — saaras:v3 code-mix STT. Routed via our custom-transcriber bridge.
# Get a key from https://dashboard.sarvam.ai
SARVAM_API_SUBSCRIPTION_KEY=
# Shunya Labs — wss://asr.shunyalabs.ai/ws. Routed via our custom-transcriber bridge.
SHUNYA_API_KEY=
# Public URL (wss://...) that Vapi can reach for the custom-transcriber bridge.
# Leave empty in dev (falls back to API_PUBLIC_URL's host).
CUSTOM_TRANSCRIBER_PUBLIC_URL=
# Shared secret HMACed into Vapi's custom-transcriber handshake (optional in dev).
CUSTOM_TRANSCRIBER_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_MODEL_FALLBACK=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Code-execution sandbox (Judge0) for assessment coding-item auto-grade ---
# Self-host (e.g. http://localhost:2358) or RapidAPI base URL. Unset => coding
# items are routed to manual review and /attempts/:id/run-code returns 503.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=

# --- Blob storage (local FS for MVP) ---
BLOB_ROOT=./var/blobs

# --- Web app ---
VITE_API_BASE_URL=http://localhost:8787
VITE_WS_BASE_URL=ws://localhost:8787
APP_BASE_URL=http://localhost:5173

# --- Transactional email (Resend) ---
# If unset, verification/reset/invitation links are logged to the API console.
RESEND_API_KEY=
RESEND_FROM=RecruitAssist <no-reply@recruitassist.local>

# --- Vapi (voice agent provider) ---
# From https://dashboard.vapi.ai -> API Keys
# Private key: server-only, never bundled into the frontend.
VAPI_API_KEY=
# Public key: safe to hand to the browser SDK for in-browser test calls.
VAPI_PUBLIC_KEY=
# Generate locally: `openssl rand -hex 32`
# Shared HMAC secret for verifying Vapi -> RecruitAssist webhook payloads.
VAPI_WEBHOOK_SECRET=
# Override only if Vapi moves endpoints.
# VAPI_API_BASE=https://api.vapi.ai

# --- Bootstrap admin (dev only) ---
# If both are set and no users exist, migrate creates this admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- J2W Offer Letter MySQL (read-only) ---
# Source of truth for demands, recruiter assignments, candidate dedup pool,
# and downstream funnel. See docs/offer-letter-db.md for schema reference.
# All values optional in dev — when unset, OL-backed routes return 503.
OFFER_LETTER_MYSQL_HOST=j2wofferletter-prod.ca8kj4bjkq5a.ap-south-1.rds.amazonaws.com
OFFER_LETTER_MYSQL_PORT=3306
OFFER_LETTER_MYSQL_USER=mis_operations
OFFER_LETTER_MYSQL_PASSWORD=
OFFER_LETTER_MYSQL_DATABASE=offerletter
OFFER_LETTER_MYSQL_TLS=true

# --- Proctor cockpit: identity face-match (AWS Rekognition) ---
# Optional in dev. When unset, the proctor identity-match endpoint runs in
# deterministic-stub mode; requesting the real path (?real=true) returns 503
# {error:"face_match_provider_missing"}, never a 500.
AWS_REKOGNITION_ACCESS_KEY_ID=
AWS_REKOGNITION_SECRET_ACCESS_KEY=
AWS_REKOGNITION_REGION=ap-south-1

# --- Proctor cockpit: live webcam/screen feeds (LiveKit) ---
# 'none' (default) = snapshot-only mode. Set to 'livekit' + keys to mint viewer
# tokens for live feeds. When 'livekit' is selected with keys unset, the
# stream-token endpoint returns 503 {error:"stream_provider_missing"}.
PROCTOR_STREAM_PROVIDER=none
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# --- Call recording storage ---
# Local FS path for WAV dumps. In prod this maps to a host-mounted volume on
# the VM at /opt/recruitassist/var/audio-dumps; the container sees it as
# /var/audio-dumps via the docker-compose volume mount.
DUMP_DIR=./var/audio-dumps
RECORDING_RETENTION_DAYS=90
