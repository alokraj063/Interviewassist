# Vite production-build overrides (loaded by `vite build`/`vite preview`, which
# run in production mode; envDir is the repo root). These point the web SPA at
# the public subpath on the mrr domain. Caddy strips /ai-interview-agent before
# forwarding to the API on :8787, so the api itself still sees /api and /ws.
# Only VITE_* vars belong here — the api/worker read the plain .env via dotenv.
VITE_API_BASE_URL=https://mrr-process-tracker.joulestowatts.com/ai-interview-agent
VITE_WS_BASE_URL=wss://mrr-process-tracker.joulestowatts.com/ai-interview-agent
